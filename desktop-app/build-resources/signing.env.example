# Windows code signing placeholders.
# Keep real certificate files and passwords out of source control.

# PFX file path, base64-encoded PFX, or secure URL depending on CI setup.
WIN_CSC_LINK=C:\secure-certs\mwangiz-ev-code-signing.pfx

# Certificate private key password, stored as a CI secret.
WIN_CSC_KEY_PASSWORD=replace-with-ci-secret

# Optional EV token/store identity. Use when signing from the Windows cert store.
WIN_CSC_SUBJECT_NAME=Mwangiz Payments

# Optional build metadata. Electron Builder appends BUILD_NUMBER to FileVersion.
BUILD_NUMBER=1
