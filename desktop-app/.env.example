# Vite exposes only variables prefixed with VITE_ to React.
# GitHub release builds must set these as repository Variables or Secrets too;
# desktop-app/.env is intentionally not committed or uploaded to Actions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_BASE_URL=https://your-production-api.example.com
VITE_DEFAULT_BRANCH_ID=

# Requested aliases for deployment notes. These are not read by Vite unless prefixed with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-public-anon-key

# Keep real Daraja secrets in ../server/.env only. These placeholders are intentionally unused by the desktop app.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
CALLBACK_URL=
