NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOW_MEMORY_FALLBACK=true
PAYMENT_TIMEOUT_MS=90000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-public-anon-key

DARAJA_USE_MOCK=true
DARAJA_MOCK_AUTO_COMPLETE=false
DARAJA_MOCK_AUTO_COMPLETE_DELAY_MS=2500
DARAJA_CONSUMER_KEY=sandbox-consumer-key
DARAJA_CONSUMER_SECRET=sandbox-consumer-secret
DARAJA_PASSKEY=sandbox-passkey
DARAJA_SHORTCODE=174379
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_OAUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
DARAJA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
CALLBACK_URL=https://example.com/api/callback
